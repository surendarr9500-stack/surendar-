# CAPACITY CONNECT - Environment Variables Template
# Copy to .env and fill with real values. Never commit .env

# Backend
DATABASE_URL=postgresql://capacity_user:strong_password@localhost:5432/capacity_connect
# For dev fallback SQLite:
# DATABASE_URL=sqlite:///./capacity_connect.db
JWT_SECRET=change-this-to-a-very-strong-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000,http://127.0.0.1:8001
STORAGE_PATH=./storage
LOG_LEVEL=info
ENVIRONMENT=development
API_V1_PREFIX=/api/v1

# Local AI Engine
AI_ENGINE_HOST=127.0.0.1
AI_ENGINE_PORT=8001
AI_ENGINE_LOG_LEVEL=info
KNOWLEDGE_BASE_PATH=./knowledge_base
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
ENABLE_LLM=false

# Client (used via --dart-define)
# API_BASE_URL=http://localhost:8000/api/v1
# AI_ENGINE_URL=http://127.0.0.1:8001
# ENVIRONMENT=development

# Security
ENCRYPTION_KEY=base64-encoded-32-byte-key-for-AES-256-GCM
# Generate with: python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"

# Admin Seed
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@moes.gov.in
ADMIN_PASSWORD=Admin@123
